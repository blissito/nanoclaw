#!/usr/bin/env bash
# analyze-audio: describe the CONTENT of an audio file (music or speech).
# Exact facts via ffprobe + semantic description via OpenAI audio model.
# Usage: analyze-audio /path/to/audio.(ogg|mp3|wav|m4a)
set -euo pipefail

AUDIO="${1:?Usage: analyze-audio /path/to/audio.(ogg|mp3|wav|m4a)}"
[[ -f "$AUDIO" ]] || { echo "ERROR: file not found: $AUDIO" >&2; exit 1; }

# --- Exact technical facts via ffprobe ---
PROBE=$(ffprobe -v error -show_entries format=duration:stream=codec_name,sample_rate,channels -of json "$AUDIO" 2>/dev/null || echo '{}')

echo "=== Datos exactos (ffprobe) ==="
python3 - "$PROBE" <<'PY'
import json, sys
d = json.loads(sys.argv[1] or "{}")
dur = d.get("format", {}).get("duration")
s = (d.get("streams") or [{}])[0]
print(f"Duración: {round(float(dur),1)}s" if dur else "Duración: ?")
print(f"Códec: {s.get('codec_name','?')}  Sample rate: {s.get('sample_rate','?')}Hz  Canales: {s.get('channels','?')}")
PY
echo ""

# --- Semantic description via OpenAI audio model ---
if [[ -z "${OPENAI_API_KEY:-}" ]]; then
  echo "(sin OPENAI_API_KEY: no se pudo describir mood/género/instrumentos)" >&2
  exit 0
fi

# Modelo de audio de OpenAI (chat completions con input_audio).
MODEL="${AUDIO_ANALYZE_MODEL:-gpt-audio-mini}"

# OpenAI input_audio acepta mp3/wav (no ogg) -> transcodear.
TMP_MP3="/tmp/analyze-$(date +%s%3N).mp3"
REQ_FILE="/tmp/analyze-req-$(date +%s%3N).json"
trap 'rm -f "$TMP_MP3" "$REQ_FILE"' EXIT
ffmpeg -nostdin -loglevel error -i "$AUDIO" -ac 1 -ar 16000 -b:a 64k "$TMP_MP3" -y

PROMPT='Analiza este audio y responde en español mexicano, máximo 6 líneas. Indica: (1) ¿es música, voz, o ambas? (2) si es música: mood/ánimo, género o estilo, instrumentos que se escuchan, tempo aproximado (lento/medio/rápido, y ~BPM SOLO si es muy claro), y si trae voz/letra. (3) si es voz: idioma y de qué habla en una frase. Sé honesto sobre la incertidumbre; NO inventes datos exactos.'

# Build the request with python (reads mp3 from disk -> avoids argv size limits).
python3 - "$TMP_MP3" "$PROMPT" "$REQ_FILE" "$MODEL" <<'PY'
import json, base64, sys
mp3, prompt, out, model = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
with open(mp3, "rb") as f:
    b64 = base64.b64encode(f.read()).decode()
json.dump({
    "model": model,
    "modalities": ["text"],
    "messages": [{"role": "user", "content": [
        {"type": "text", "text": prompt},
        {"type": "input_audio", "input_audio": {"data": b64, "format": "mp3"}},
    ]}],
}, open(out, "w"))
PY

RESP=$(curl -sS -X POST "https://api.openai.com/v1/chat/completions" \
  -H "Authorization: Bearer $OPENAI_API_KEY" \
  -H "Content-Type: application/json" \
  -d @"$REQ_FILE" || echo '')

echo "=== Descripción del contenido (estimación del modelo, NO medición DSP exacta) ==="
python3 - "$RESP" <<'PY'
import json, sys
try:
    d = json.loads(sys.argv[1])
    print(d["choices"][0]["message"]["content"].strip())
except Exception:
    err = ""
    try:
        err = json.loads(sys.argv[1]).get("error", {}).get("message", "")
    except Exception:
        pass
    print("ERROR analizando audio" + (f": {err}" if err else ""), file=sys.stderr)
    sys.exit(1)
PY

# Cost tracking via IPC (non-fatal)
{
  IPC_DIR="/workspace/ipc/messages"; mkdir -p "$IPC_DIR"
  TRACK="${IPC_DIR}/imgtrack-$(date +%s%3N).json"
  python3 - "$AUDIO" "$TRACK" <<'PY'
import json, sys
json.dump({
    "type": "track_image_gen",
    "gen_type": "audio_analyze",
    "prompt": sys.argv[1][:100],
    "model": "gpt-audio-mini",
    "cost_usd": 0.01,
}, open(sys.argv[2], "w"))
PY
} || true
