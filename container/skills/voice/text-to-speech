#!/usr/bin/env bash
# text-to-speech: convert text to audio using Kokoro (local, free) with OpenAI onyx fallback.
# Usage: text-to-speech "text to speak" [voice-name]
# Voices (Spanish, Kokoro): santa (default), alex, dora.
#   Legacy names are remapped so old calls/tasks keep working.
set -euo pipefail

TEXT="${1:?Usage: text-to-speech \"text\" [voice-name]}"
VOICE_NAME="${2:-santa}"
OUTPUT_DIR="/workspace/group"
OUTPUT_FILE="${OUTPUT_DIR}/tts-$(date +%s%3N).ogg"

KOKORO_MODEL="${KOKORO_MODEL:-/opt/kokoro/kokoro-v1.0.onnx}"
KOKORO_VOICES="${KOKORO_VOICES:-/opt/kokoro/voices-v1.0.bin}"

# --- Voice catalog (name -> Kokoro voice id) ---
# Kokoro español ships 3 voices: em_santa, em_alex (male), ef_dora (female).
# Legacy ElevenLabs names map onto these so existing skills/tasks don't break.
declare -A VOICES=(
  [santa]="em_santa"
  [alex]="em_alex"
  [dora]="ef_dora"
  # US English (Kokoro American voices) — lang auto-selected below
  [us]="am_michael"
  [michael]="am_michael"
  [liam]="am_liam"
  [adam]="am_adam"
  [eric]="am_eric"
  [bella]="af_bella"
  [heart]="af_heart"
  [nova]="af_nova"
  [sarah]="af_sarah"
  # legacy male -> em_alex (default stays santa)
  [antonio]="em_alex"
  [jc]="em_alex"
  [brian]="em_alex"
  [daniel]="em_alex"
  [enrique]="em_alex"
  # legacy female -> ef_dora
  [maya]="ef_dora"
  [cristina]="ef_dora"
  [regina]="ef_dora"
)

if [[ -n "${VOICES[$VOICE_NAME]+x}" ]]; then
  KOKORO_VOICE="${VOICES[$VOICE_NAME]}"
elif [[ "$VOICE_NAME" == "custom" || "$VOICE_NAME" == "cloned" ]]; then
  # Voice cloning was ElevenLabs-only and is no longer available; use the default.
  KOKORO_VOICE="em_santa"
  echo "WARNING: cloned voices unavailable (Kokoro has no cloning), using santa" >&2
else
  KOKORO_VOICE="em_santa"
  echo "WARNING: Unknown voice '$VOICE_NAME', using santa" >&2
fi

# --- Kokoro TTS (primary, local, free) ---
if [[ -f "$KOKORO_MODEL" && -f "$KOKORO_VOICES" ]]; then
  WAV_FILE="${OUTPUT_FILE%.ogg}.wav"
  # Bound onnxruntime/OpenMP threads. Leaving OMP_NUM_THREADS unset lets onnxruntime
  # oversubscribe on small CPUs (thrashing), which measured ~9s vs ~3.5s when bounded
  # to the core count. Tune per-droplet with KOKORO_THREADS (default 4).
  if KOKORO_MODEL="$KOKORO_MODEL" KOKORO_VOICES="$KOKORO_VOICES" \
     OMP_NUM_THREADS="${KOKORO_THREADS:-4}" \
     python3 - "$TEXT" "$KOKORO_VOICE" "$WAV_FILE" <<'PY' 2>/tmp/kokoro-err.log
import os, sys
from kokoro_onnx import Kokoro
import soundfile as sf
text, voice, out = sys.argv[1], sys.argv[2], sys.argv[3]
k = Kokoro(os.environ["KOKORO_MODEL"], os.environ["KOKORO_VOICES"])
lang = "en-us" if voice[:1] == "a" else ("en-gb" if voice[:1] == "b" else "es")
samples, sr = k.create(text, voice=voice, speed=1.0, lang=lang)
sf.write(out, samples, sr)
PY
  then
    # WAV -> OGG opus (WhatsApp-compatible)
    if ffmpeg -y -i "$WAV_FILE" -c:a libopus -b:a 64k -ar 48000 -ac 1 "$OUTPUT_FILE" >/dev/null 2>&1; then
      rm -f "$WAV_FILE"
      # Track via IPC (non-fatal). Kokoro is local => no cost.
      {
        IPC_DIR="/workspace/ipc/messages"
        mkdir -p "$IPC_DIR"
        TRACK_FILE="${IPC_DIR}/imgtrack-$(date +%s%3N).json"
        python3 -c "
import json, sys
json.dump({
    'type': 'track_image_gen',
    'gen_type': 'tts',
    'prompt': sys.argv[1][:100],
    'model': 'kokoro-onnx',
    'cost_usd': 0.0
}, open(sys.argv[2], 'w'))
" "$TEXT" "$TRACK_FILE"
      } || true

      echo "$OUTPUT_FILE"
      exit 0
    else
      rm -f "$WAV_FILE" "$OUTPUT_FILE"
      echo "WARNING: ffmpeg conversion failed, falling back to OpenAI" >&2
    fi
  else
    rm -f "$WAV_FILE"
    echo "WARNING: Kokoro TTS failed, falling back to OpenAI" >&2
    cat /tmp/kokoro-err.log >&2 || true
  fi
fi

# --- OpenAI fallback (onyx) ---
if [[ -z "${OPENAI_API_KEY:-}" ]]; then
  echo "ERROR: Kokoro unavailable and no OPENAI_API_KEY for fallback" >&2
  exit 1
fi

VOICE="onyx"
RESPONSE_CODE=$(curl -sS -w "%{http_code}" -o "$OUTPUT_FILE" \
  -X POST "https://api.openai.com/v1/audio/speech" \
  -H "Authorization: Bearer $OPENAI_API_KEY" \
  -H "Content-Type: application/json" \
  -d "$(python3 -c "
import json, sys
print(json.dumps({
    'model': 'tts-1-hd',
    'input': sys.argv[1],
    'voice': sys.argv[2],
    'response_format': 'opus'
}))
" "$TEXT" "$VOICE")")

if [[ "$RESPONSE_CODE" != "200" ]]; then
  ERROR=$(cat "$OUTPUT_FILE" 2>/dev/null || echo "HTTP $RESPONSE_CODE")
  rm -f "$OUTPUT_FILE"
  echo "ERROR: OpenAI TTS: $ERROR" >&2
  exit 1
fi

# Track via IPC (non-fatal)
{
  IPC_DIR="/workspace/ipc/messages"
  mkdir -p "$IPC_DIR"
  TRACK_FILE="${IPC_DIR}/imgtrack-$(date +%s%3N).json"
  python3 -c "
import json, sys
json.dump({
    'type': 'track_image_gen',
    'gen_type': 'tts',
    'prompt': sys.argv[1][:100],
    'model': 'openai-tts-1',
    'cost_usd': 0.015
}, open(sys.argv[2], 'w'))
" "$TEXT" "$TRACK_FILE"
} || true

echo "$OUTPUT_FILE"
